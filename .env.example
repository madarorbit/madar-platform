NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_EMAIL=

# Existing MADAR Integration Engine server-only configuration.
MADAR_INTEGRATION_MASTER_KEY=
MADAR_INTEGRATION_KEY_VERSION=1
MADAR_INTEGRATION_WORKER_SECRET=

# ORBY Agent + Stage 3 intelligence worker. Falls back to MADAR_INTEGRATION_WORKER_SECRET or CRON_SECRET.
MADAR_ORBY_WORKER_SECRET=

# Optional durable execution adapter. The internal MADAR queues remain authoritative.
MADAR_TRIGGER_ENABLED=false
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev
MADAR_TRIGGER_INTEGRATION_TASK_ID=madar-integration-worker
MADAR_TRIGGER_ORBY_TASK_ID=madar-orby-worker

# Trigger.dev runtime variables (configure them in the isolated Trigger project, not in the browser).
TRIGGER_PROJECT_REF=
MADAR_BASE_URL=https://www.orbitmadar.com

# Optional Langfuse OTLP observability. Request/response content is NOT exported by default.
MADAR_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
MADAR_OBSERVABILITY_CAPTURE_CONTENT=false

# Optional OpenMeter usage mirror. MADAR quota and subscription tables remain the source of truth.
MADAR_OPENMETER_ENABLED=false
OPENMETER_BASE_URL=
OPENMETER_API_KEY=
OPENMETER_EVENTS_PATH=/api/v1/events

# Optional OpenFGA fine-grained authorization. Start in shadow mode; MADAR never accepts an OpenFGA grant when its own checks deny.
MADAR_OPENFGA_ENABLED=false
MADAR_OPENFGA_MODE=shadow
OPENFGA_API_URL=
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_API_TOKEN=

# Optional Svix outbound webhooks. A separate Svix application is created for every MADAR organization.
MADAR_SVIX_ENABLED=false
SVIX_API_URL=https://api.svix.com
SVIX_AUTH_TOKEN=

# Optional Nango OAuth/connect adapter. Only integrations in this comma-separated allowlist can be requested.
MADAR_NANGO_ENABLED=false
NANGO_API_URL=https://api.nango.dev
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
MADAR_NANGO_ALLOWED_INTEGRATIONS=

# Optional provider-independent OCR adapter for scanned PDFs and images.
ORBY_OCR_ENDPOINT=
ORBY_OCR_API_KEY=

# ORBY provider credentials are server-side only. Never prefix them with NEXT_PUBLIC_.
ORBY_OPENAI_API_KEY=
ORBY_OPENAI_BASE_URL=
ORBY_OPENAI_PROVIDER_ID=
ORBY_ANTHROPIC_API_KEY=
ORBY_ANTHROPIC_BASE_URL=
ORBY_GEMINI_API_KEY=
ORBY_GEMINI_BASE_URL=
ORBY_LOCAL_LLM_BASE_URL=
ORBY_LOCAL_LLM_API_KEY=
ORBY_LOCAL_LLM_PROVIDER_ID=
