{
  "name": "madar-mobile",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "export:android": "expo export --platform android --output-dir dist",
    "check": "npm run typecheck && npm run lint && npm run export:android",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:aab": "eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@madar/contracts": "file:../packages/contracts",
    "@react-native-community/netinfo": "^11.4.1",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "~57.0.1",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.18.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~6.0.3"
  }
}
