{
  "name": "madar-mobile",
  "version": "2.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "export:android": "expo export --platform android --output-dir dist",
    "check": "npm run typecheck && npm run lint && npm run doctor && npm run export:android",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:aab": "eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@madar/contracts": "file:../packages/contracts",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "~57.0.1",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
}
