{
  "expo": {
    "name": "مَدار | ORBIT",
    "slug": "madar-mobile",
    "owner": "madarorbit",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "madar",
    "icon": "../public/brand/symbol-512x512.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "../public/brand/symbol-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A12"
    },
    "android": {
      "package": "com.orbitmadar.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "../public/brand/symbol-512x512.png",
        "backgroundColor": "#070A12"
      },
      "permissions": ["USE_BIOMETRIC"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "madar", "host": "auth" },
            { "scheme": "https", "host": "www.orbitmadar.com", "pathPrefix": "/auth/mobile" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.orbitmadar.mobile",
      "buildNumber": "2",
      "supportsTablet": false,
      "associatedDomains": ["applinks:www.orbitmadar.com"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "../public/brand/symbol-512x512.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#070A12",
          "dark": { "backgroundColor": "#070A12" }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../public/brand/symbol-512x512.png",
          "color": "#70E4D4",
          "defaultChannel": "madar-operations"
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "router": { "origin": false } }
  }
}
